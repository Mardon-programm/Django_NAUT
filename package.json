{
  "name": "djangonaut",
  "version": "1.0.0",
  "description": "Полноценная IDE для Django с терминалом, AI-ассистентом и деплоем",
  "main": "main.js",
  "author": "DjangoNAUT",
  "license": "MIT",
  "homepage": "https://github.com/user/djangonaut",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win -p never",
    "build:mac": "electron-builder --mac -p never",
    "build:linux": "electron-builder --linux -p never",
    "build:all": "electron-builder -wml -p never"
  },
  "build": {
    "appId": "com.djangonaut.ide",
    "productName": "DjangoNAUT",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "terminal-server.js",
      "django-scanner.js",
      "bughunter.js",
      "index.html",
      "styles.css",
      "logo.png",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "python-agent",
        "to": "python-agent"
      }
    ],
    "asarUnpack": [
      "terminal-server.js",
      "node_modules/ws/**/*",
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DjangoNAUT",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "mac": {
      "icon": "icons.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "desktop": {
        "Name": "DjangoNAUT",
        "Comment": "Desktop IDE for Django",
        "StartupWMClass": "djangonaut"
      }
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^41.2.2",
    "electron-builder": "^25.1.8"
  }
}
